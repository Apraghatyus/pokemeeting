{
  "name": "emupoke-together",
  "version": "0.1.0",
  "private": true,
  "description": "Emulador de GBA en el navegador, exclusivo para Pokemon, con partida compartida y Soul Link. No distribuye ROMs.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@emupoke/web",
    "dev:signaling": "npm run dev --workspace=@emupoke/signaling",
    "build": "npm run build --workspace=@emupoke/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node tools/smoke.mjs",
    "dev:all": "node tools/dev.mjs",
    "test:signaling": "node tools/test-signaling.mjs",
    "test:session": "node tools/test-session.mjs",
    "dev:https": "npm run dev:https --workspace=@emupoke/web",
    "test:mobile": "node tools/test-mobile.mjs",
    "test:roms": "npx tsx tools/test-roms.mjs",
    "dev:randomizer": "npm run dev --workspace=@emupoke/randomizer",
    "test:randomizer": "node tools/test-randomizer.mjs",
    "test:randomizer:ui": "node tools/test-randomizer-ui.mjs",
    "test:voice": "node tools/test-voice.mjs",
    "test:randomizer:options": "node tools/test-randomizer-options.mjs",
    "dev:tunnel": "npm run dev:tunnel --workspace=@emupoke/web",
    "test:audio": "node tools/test-audio.mjs",
    "test:reconexion": "node tools/test-reconexion.mjs",
    "tunnel": "node tools/tunnel.mjs",
    "test:partidas": "node tools/test-randomizer-limpio.mjs",
    "test:gen3": "npx tsx tools/memoria/test-gen3.mjs",
    "memoria:volcar": "node tools/memoria/volcar-savestate.mjs",
    "memoria:analizar": "npx tsx tools/memoria/analizar-savestate.mjs",
    "memoria:nombres": "npx tsx tools/memoria/buscar-nombres.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
