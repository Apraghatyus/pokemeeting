# Copia esto a deploy/.env en el homelab y rellena la contrasena.
#
#   cp deploy/.env.ejemplo deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d base
#
# El .env NO se versiona: lleva la contrasena de la base.

# --- La base de datos ---------------------------------------------------

# Obligatoria. Genera una larga y no la reutilices de otro sitio:
#   openssl rand -base64 32
EMUPOKE_PG_CLAVE=

# Estos tres tienen valor por defecto y casi nunca hay que tocarlos.
#EMUPOKE_PG_BASE=emupoke
#EMUPOKE_PG_USUARIO=emupoke
#EMUPOKE_PG_PUERTO=5432

# En que direccion escucha la base.
#
# Por defecto 127.0.0.1: solo desde el propio homelab. El servidor no la
# necesita abierta -le llega por la red interna de Docker-, asi que esto es
# unicamente para conectarse desde fuera a desarrollar o a respaldar.
#
# Para trabajar contra ella desde el portatil, pon aqui la IP de Tailscale del
# homelab. NUNCA pongas 0.0.0.0: eso la deja abierta a toda la red local.
#EMUPOKE_PG_BIND=100.x.y.z

# --- Lo que ya habia ----------------------------------------------------

#EMUPOKE_PORT=8790
#EMUPOKE_REPO=..
