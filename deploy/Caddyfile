# Detras de Cloudflare Tunnel (o NPM): el HTTPS lo pone quien esta delante.
{
	auto_https off
	admin off
	servers {
		# QUIEN PUEDE DECIR CUAL ES LA IP DEL VISITANTE.
		#
		# Solo el proxy que tienes delante -cloudflared, NPM, nginx- y por su IP
		# exacta. NO pongas la subred entera: el trafico que entra directo por
		# :8790 viene de la puerta de enlace de esa misma red y podria
		# falsificar la cabecera para saltarse el limite de intentos.
		#
		# EL VALOR DE ABAJO ES UN EJEMPLO y hay que cambiarlo por el de tu
		# instalacion: ponlo en EMUPOKE_PROXY_FIABLE, en el .env. Si no lo
		# cambias no se rompe nada, pero tampoco sirve: una IP que no existe en
		# tu red no es nadie, y entonces no se cree la cabecera a nadie -que es
		# el lado seguro de equivocarse-. Para saber cual es la tuya:
		#
		#   docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' cloudflared
		trusted_proxies static {$EMUPOKE_PROXY_FIABLE:192.168.128.2/32}
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
}

:80 {
	encode gzip

	# Sin estas dos el nucleo del emulador arranca y falla en silencio.
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /signaling* {
		uri strip_prefix /signaling
		reverse_proxy {$SERVIDOR:emupoke-servidor}:8787
	}

	handle /cuentas* {
		request_body {
			max_size 1MB
		}
		uri strip_prefix /cuentas
		reverse_proxy {$SERVIDOR:emupoke-servidor}:8789 {
			# Sin esto el limite de intentos de login ve a TODO el mundo con la
			# IP de cloudflared y se convierte en un cupo global.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /randomizer* {
		request_body {
			max_size 64MB
		}
		uri strip_prefix /randomizer
		reverse_proxy {$SERVIDOR:emupoke-servidor}:8788 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
