# ---- Legal: NUNCA subir ROMs ni saves ----
# Este proyecto es un emulador. No distribuye juegos.
*.gba
*.gbc
*.gb
*.sav
*.srm
*.ss[0-9]
*.state
roms/
saves/
Emupoke.bat
Emupoke-pruebas.bat

# Dependencias y build
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Entorno
.env
.env.local
.env.*.local

# Logs y editor
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Excepcion: si documentamos la carpeta de ROMs, ese README si se versiona
!roms/README.md

# Nucleo mGBA copiado desde node_modules por sync-core.mjs: artefacto generado
apps/web/public/mgba/

# El jar del randomizer es de terceros y con licencia GPL-3: no se versiona
tools/randomizer/*.jar

# cloudflared es un binario de terceros de 55 MB: se descarga, no se versiona
tools/cloudflared.exe

# Capturas que dejan las pruebas al correrlas sin indicar carpeta.
*.png

# Pero los de la marca SI van: son parte del producto, no basura de una prueba.
# Sin estas dos lineas el icono y el logotipo se quedaban fuera del commit sin
# decir nada, que es como se descubrio esta regla.
!apps/web/public/*.png
!docs/marca/*.png

# El nucleo de DS lo baja tools/nds/preparar.mjs: es de otra gente y pesa 7 MB.
tools/nds/nucleo/

# Certificados de Tailscale: `tailscale cert` los escribe en la carpeta desde la
# que se llama, y uno de los dos es una CLAVE PRIVADA. El Funnel no los
# necesita -Tailscale los gestiona por dentro-, asi que si aparecen aqui es por
# accidente y no deben acabar en un commit.
*.crt
*.key
*.pem
