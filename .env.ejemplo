# Para desarrollar. Copia esto a .env y rellena lo que necesites.
#
#   cp .env.ejemplo .env
#
# El .env NO se versiona. Sin el, todo funciona igual salvo el servicio de
# cuentas, que simplemente no se arranca.

# Donde esta la base de datos de las cuentas.
#
# Apuntando al homelab por Tailscale, que es donde corre de verdad. Para que
# acepte conexiones desde aqui, en el .env del servidor tiene que estar puesto
# EMUPOKE_PG_BIND con su IP y el tunel levantado:
#
#   docker compose -f deploy/docker-compose.yml --profile dev up -d tunel-dev
#
#   DATABASE_URL=postgres://emupoke_dev:LA-CLAVE@100.x.y.z:5434/emupoke_dev
DATABASE_URL=

# Cuantas conexiones abre el servicio de cuentas.
#
# Tiene que caber en lo que permita el otro lado. Contra la base de desarrollo
# del homelab son 5 -el rol y el tunel-, asi que aqui va 4. En produccion se
# deja sin poner y usa 10.
CUENTAS_MAX_CONEXIONES=4

# Cuantas cuentas se pueden crear por hora desde una misma direccion.
#
# En produccion se deja sin poner y usa 20. Aqui hace falta mas: cada prueba de
# interfaz abre una cuenta, y todas vienen de la misma direccion.
CUENTAS_MAX_ALTAS=500
